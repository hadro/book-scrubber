{
  "name": "book-scrubber",
  "private": true,
  "type": "module",
  "description": "Hover-to-scrub through digitized books from any IIIF manifest, and make GIFs.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "social-card": "node scripts/make-social-card.mjs",
    "check-examples": "node scripts/check-examples.mjs"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "playwright": "^1.56.1"
  }
}
